var i = args.find("D")
if (i == -1) {
	throw("Invalid emoticon")
}
var emoticon = trim(args.substr(0, i))
var msg = trim(args.substr(i + 1, -1))
var text = msg.empty() ? emoticon : msg + " " + emoticon
var line = "say \""
for (var j = 0; j < text.size(); ++j) {
	var c = text[j]
	if (c == '\\' || c == '"') {
		line.push_back('\\')
	}
	line.push_back(c)
}
exec(line + "\"")
